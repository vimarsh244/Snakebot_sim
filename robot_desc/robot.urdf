  <joint name="module_4_servo_a" type="revolute"><origin xyz="0.028 -0.018 0" rpy="0 0 0"/><parent link="plate_4"/><child link="module_4_rod_main"/><axis xyz="0 0 1"/><limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/></joint>
  <link name="plate_5"><inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/fusioncomponent.stl"/></geometry><material name="plate_white"/></visual><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/servo_motor_35kg_motor_v1.stl"/></geometry><material name="servo_dark"/></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.12 0.12 0.016"/></geometry></collision></link>
