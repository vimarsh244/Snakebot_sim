<?xml version="1.0"?>
<robot name="snakebot_5_module">
  <!-- this urdf is a clean kinematic tree matching the new mjcf layout.
       closed-loop rods are represented as fixed decorative links because
       urdf tree structure does not natively support loop constraints. -->

  <material name="plate_white">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>
  <material name="servo_dark">
    <color rgba="0.15 0.15 0.2 1"/>
  </material>
  <material name="rod_white">
    <color rgba="0.95 0.95 0.95 1"/>
  </material>

  <link name="plate_0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../stls/fusioncomponent.stl"/></geometry>
      <material name="plate_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../stls/servo_motor_35kg_motor_v1.stl"/></geometry>
      <material name="servo_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.12 0.016"/></geometry>
    </collision>
  </link>

  <!-- module 0 -->
  <link name="module_0_rod_main">
    <inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_v4.stl"/></geometry><material name="rod_white"/></visual>
    <collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision>
  </link>
  <joint name="module_0_servo_a" type="revolute">
    <origin xyz="0.028 -0.018 0" rpy="0 0 0"/>
    <parent link="plate_0"/>
    <child link="module_0_rod_main"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/>
  </joint>

  <link name="plate_1">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/fusioncomponent.stl"/></geometry><material name="plate_white"/></visual>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/servo_motor_35kg_motor_v1.stl"/></geometry><material name="servo_dark"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.12 0.12 0.016"/></geometry></collision>
  </link>
  <joint name="module_0_servo_b" type="revolute">
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
    <parent link="module_0_rod_main"/>
    <child link="plate_1"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/>
  </joint>

  <link name="module_0_rod_support">
    <inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_support_v5.stl"/></geometry><material name="rod_white"/></visual>
    <collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision>
  </link>
  <joint name="module_0_support_fixed" type="fixed">
    <origin xyz="-0.028 0.018 0" rpy="0 0 0"/>
    <parent link="plate_0"/>
    <child link="module_0_rod_support"/>
  </joint>

  <!-- module 1 -->
  <link name="module_1_rod_main"><inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_v4.stl"/></geometry><material name="rod_white"/></visual><collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision></link>
  <joint name="module_1_servo_a" type="revolute"><origin xyz="0.028 -0.018 0" rpy="0 0 0"/><parent link="plate_1"/><child link="module_1_rod_main"/><axis xyz="0 0 1"/><limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/></joint>
  <link name="plate_2"><inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/fusioncomponent.stl"/></geometry><material name="plate_white"/></visual><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/servo_motor_35kg_motor_v1.stl"/></geometry><material name="servo_dark"/></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.12 0.12 0.016"/></geometry></collision></link>
  <joint name="module_1_servo_b" type="revolute"><origin xyz="0 0 0.11" rpy="0 0 0"/><parent link="module_1_rod_main"/><child link="plate_2"/><axis xyz="1 0 0"/><limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/></joint>
  <link name="module_1_rod_support"><inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_support_v5.stl"/></geometry><material name="rod_white"/></visual><collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision></link>
  <joint name="module_1_support_fixed" type="fixed"><origin xyz="-0.028 0.018 0" rpy="0 0 0"/><parent link="plate_1"/><child link="module_1_rod_support"/></joint>

  <!-- module 2 -->
  <link name="module_2_rod_main"><inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_v4.stl"/></geometry><material name="rod_white"/></visual><collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision></link>
  <joint name="module_2_servo_a" type="revolute"><origin xyz="0.028 -0.018 0" rpy="0 0 0"/><parent link="plate_2"/><child link="module_2_rod_main"/><axis xyz="0 0 1"/><limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/></joint>
  <link name="plate_3"><inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/fusioncomponent.stl"/></geometry><material name="plate_white"/></visual><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/servo_motor_35kg_motor_v1.stl"/></geometry><material name="servo_dark"/></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.12 0.12 0.016"/></geometry></collision></link>
  <joint name="module_2_servo_b" type="revolute"><origin xyz="0 0 0.11" rpy="0 0 0"/><parent link="module_2_rod_main"/><child link="plate_3"/><axis xyz="1 0 0"/><limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/></joint>
  <link name="module_2_rod_support"><inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_support_v5.stl"/></geometry><material name="rod_white"/></visual><collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision></link>
  <joint name="module_2_support_fixed" type="fixed"><origin xyz="-0.028 0.018 0" rpy="0 0 0"/><parent link="plate_2"/><child link="module_2_rod_support"/></joint>

  <!-- module 3 -->
  <link name="module_3_rod_main"><inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_v4.stl"/></geometry><material name="rod_white"/></visual><collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision></link>
  <joint name="module_3_servo_a" type="revolute"><origin xyz="0.028 -0.018 0" rpy="0 0 0"/><parent link="plate_3"/><child link="module_3_rod_main"/><axis xyz="0 0 1"/><limit lower="-1.0472" upper="1.0472" effort="12" velocity="4"/></joint>
  <link name="plate_4"><inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/fusioncomponent.stl"/></geometry><material name="plate_white"/></visual><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/servo_motor_35kg_motor_v1.stl"/></geometry><material name="servo_dark"/></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.12 0.12 0.016"/></geometry></collision></link>
