  <link name="module_3_rod_support"><inertial><origin xyz="0 0 0.055" rpy="0 0 0"/><mass value="0.02"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="../stls/danda_support_v5.stl"/></geometry><material name="rod_white"/></visual><collision><origin xyz="0 0 0.055" rpy="0 0 0"/><geometry><cylinder radius="0.006" length="0.11"/></geometry></collision></link>
